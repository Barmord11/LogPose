# ── Supabase ────────────────────────────────────────────────
# Create a free project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then copy these from Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Anime API functions ────────────────────────────────────
# Leave unset to use same-origin relative paths (/api/anime/...),
# which is correct both on Vercel and when running `vercel dev` locally.
# Only set this if you're running `vite dev` standalone (no serverless
# functions available) and proxying to a separately hosted /api.
# VITE_API_BASE_URL=http://localhost:3000
