# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — real Supabase keys live here, never commit them.
# .env.example is a plain local reference template, not meant to be
# tracked either - it's covered by the .env.* rule below like every
# other env file.
.env
.env.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Abandoned standalone Express/SQL Server scaffold — superseded by the
# Supabase + Vercel serverless architecture (see api/ and supabase/).
# Left on disk because it couldn't be removed from this environment;
# safe to delete by hand.
/server

# Superseded file versions left behind by a filesystem quirk in the
# build environment that blocked deleting them outright (rename-then-
# recreate was used to work around a stale-cache bug). Safe to delete
# by hand — the current, correct version has no .stale suffix.
*.stale*
*.bak

# Leftover lock/temp files from the same build-environment filesystem
# quirk above (FUSE-style mount). Safe to delete by hand.
.fuse_hidden*

# Vercel
.vercel

# Loose design-source files that keep landing at repo root (PSD
# originals + duplicate/staging PNG exports from asset drops) - the
# real, in-use copies live under public/images/ and src/assets/.
# Nothing in the app references a file at repo root, so these are
# always safe to delete if they reappear locally.
/*.psd
/BackgroundProper*.png
/NewLogo copy.png
/darkmode.png
/toggle-neutral.png
/toggledark.png
/togglelight.png
